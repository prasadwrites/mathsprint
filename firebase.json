{
  "hosting": {
    "public": "web/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "predeploy": ["npm --prefix web run build"],
    "rewrites": [
      { "source": "/c/**", "function": { "functionId": "challenge_page", "region": "us-central1" } },
      { "source": "/p/**", "function": { "functionId": "public_test_page", "region": "us-central1" } },
      { "source": "/q/**", "function": { "functionId": "question_post_page", "region": "us-central1" } },
      { "source": "/square/webhook", "function": { "functionId": "square_webhook", "region": "us-central1" } },
      { "source": "/tutors", "destination": "/tutors.html" },
      { "source": "/tutors/", "destination": "/tutors.html" },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "python312",
      "ignore": ["venv", ".git", "tests", "__pycache__", "*.local"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true }
  }
}

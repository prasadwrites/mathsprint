rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Suspended accounts lose access to their data too, not just deck generation.
    function active() {
      let account = /databases/$(database)/documents/accounts/$(request.auth.uid);
      return !exists(account) || get(account).data.status != "suspended";
    }
    function owns(data) { return signedIn() && data.ownerId == request.auth.uid && active(); }
    function isAdmin() {
      return signedIn() && request.auth.token.email == "prasad.writes@gmail.com" && request.auth.token.email_verified == true;
    }

    // People a deck was shared with (by the share_deck function) can read it and practice it.
    function sharedWithMe(data) { return signedIn() && request.auth.uid in data.get("sharedWith", []) && active(); }

    // AI decks are written only by the generate_deck function (admin access), which
    // enforces the plan's limits. Students can add the sample deck themselves and
    // can see their own decks and the ones shared with them.
    match /decks/{deckId} {
      allow read: if owns(resource.data) || sharedWithMe(resource.data);
      allow delete: if owns(resource.data);
      allow create: if owns(request.resource.data) && request.resource.data.source == "sample"
        && !("sharedWith" in request.resource.data);
      // Only the sharing functions change who a deck is shared with.
      allow update: if owns(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["ownerId", "source", "sharedWith", "sharedBy"]);

      match /questions/{questionId} {
        function deckPath() { return /databases/$(database)/documents/decks/$(deckId); }
        allow read: if signedIn() && active()
          && (get(deckPath()).data.ownerId == request.auth.uid || request.auth.uid in get(deckPath()).data.get("sharedWith", []));
        // getAfter, so a deck and its questions can be written in one batch. Only sample
        // decks are written from the app; AI decks come from the function.
        allow write: if signedIn() && active()
          && getAfter(deckPath()).data.ownerId == request.auth.uid
          && getAfter(deckPath()).data.source == "sample";
      }
    }

    match /sessions/{sessionId} {
      allow read: if owns(resource.data);
      allow create: if owns(request.resource.data) && request.resource.data.status == "active";
      // A finished session is a record; it can't be reopened or reassigned.
      allow update: if owns(resource.data)
        && resource.data.status == "active"
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.deckId == resource.data.deckId;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Plan, usage and status. Only Cloud Functions change these.
    match /accounts/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // Upgrade requests and the admin's replies. Read and written only through functions.
    match /upgradeRequests/{requestId} {
      allow read, write: if false;
    }

    match /invites/{token} {
      allow read, write: if false;
    }

    // Contact groups, the tests assigned to them (with their copy of the questions) and each member's link,
    // code and answers. Only the Cloud Functions read or write these, so answers and codes never reach a browser.
    match /groups/{groupId} {
      allow read, write: if false;
    }
    match /tests/{testId}/{document=**} {
      allow read, write: if false;
    }
    match /testTakers/{token} {
      allow read, write: if false;
    }

    // Head-to-head challenges (with their copy of the questions) and each friend's attempt. Only the Cloud Functions
    // read or write these, so the answer key never reaches the friend's browser.
    match /challenges/{token}/{document=**} {
      allow read, write: if false;
    }
    match /challengeAttempts/{token} {
      allow read, write: if false;
    }

    // Public test links (with their copy of the questions and their leaderboard) and each player's attempt. Only the
    // Cloud Functions read or write these.
    match /publicTests/{token}/{document=**} {
      allow read, write: if false;
    }
    match /publicAttempts/{token} {
      allow read, write: if false;
    }

    // Question posts for social media (with their copy of the deck's questions, answers included). Only the Cloud
    // Functions read or write these, so a visitor sees an answer only after giving theirs.
    match /questionPosts/{token}/{document=**} {
      allow read, write: if false;
    }

    // Problem reports and plan promotions. Read and written only through functions.
    match /reports/{reportId} {
      allow read, write: if false;
    }
    match /promotions/{promotionId} {
      allow read, write: if false;
    }

    // Per-account access codes. Read and written only through the admin functions.
    match /accessCodes/{uid} {
      allow read, write: if false;
    }
  }
}
